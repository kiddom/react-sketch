{
  "name": "@kiddom/react-sketch",
  "version": "0.11.7",
  "description": "Sketch Element for React based applications, backed-up by fabricjs as its core",
  "keywords": [
    "react",
    "canvas",
    "sketch",
    "fabricjs",
    "fabric.js"
  ],
  "author": {
    "name": "Kiddom",
    "email": "engineering@kiddom.co"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/kiddom/react-sketch.git"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com"
  },
  "license": "MIT",
  "main": "./dist",
  "types": "./types/index.d.ts",
  "scripts": {
    "build": "cross-env NODE_ENV=production webpack --mode production --config webpack/library.cfg.js --display-modules",
    "build:light": "babel ./src --out-dir ./dist",
    "build:examples": "cross-env NODE_ENV=production webpack --mode production --config webpack/examples.cfg.js",
    "clean": "rimraf dist build",
    "lint": "eslint ./src",
    "lint:fix": "eslint --fix ./src",
    "precommit": "lint-staged",
    "prepublish": "npm run build",
    "prebuild": "rimraf dist",
    "start": "node webpack/server.js",
    "test": "jest --coverage"
  },
  "engines": {
    "node": ">= 8"
  },
  "lint-staged": {
    "*.{js,jsx,css,md}": [
      "eslint --fix",
      "git add"
    ]
  },
  "jest": {
    "automock": false,
    "testEnvironment": "@happy-dom/jest-environment",
    "moduleNameMapper": {
      "\\.(css|scss)$": "identity-obj-proxy",
      "^canvas$": "jest-canvas-mock"
    },
    "transform": {
      "^.+\\.(js|jsx)$": "babel-jest"
    },
    "testRegex": "./test/.*.jsx?$",
    "setupFilesAfterEnv": [
      "<rootDir>/jest.setup.js"
    ],
    "moduleFileExtensions": [
      "js",
      "json",
      "jsx"
    ]
  },
  "resolutions": {
    "babel-core": "7.0.0-bridge.0"
  },
  "overrides": {
    "test-exclude": "^7.0.1"
  },
  "devDependencies": {
    "@babel/cli": "^7.28.6",
    "@babel/core": "7.29.0",
    "@babel/plugin-proposal-class-properties": "7.18.6",
    "@babel/plugin-proposal-decorators": "7.29.0",
    "@babel/plugin-proposal-export-namespace-from": "7.18.9",
    "@babel/plugin-proposal-function-sent": "7.27.1",
    "@babel/plugin-proposal-json-strings": "7.18.6",
    "@babel/plugin-proposal-numeric-separator": "7.18.6",
    "@babel/plugin-proposal-throw-expressions": "7.27.1",
    "@babel/plugin-syntax-dynamic-import": "7.8.3",
    "@babel/plugin-syntax-import-meta": "7.10.4",
    "@babel/plugin-transform-runtime": "7.29.0",
    "@babel/polyfill": "7.12.1",
    "@babel/preset-env": "7.29.0",
    "@babel/preset-react": "7.28.5",
    "@babel/register": "7.28.6",
    "@babel/runtime": "7.28.6",
    "@happy-dom/jest-environment": "^17.4.0",
    "@material-ui/core": "^4.12.4",
    "@material-ui/icons": "^4.11.3",
    "@testing-library/jest-dom": "5.17.0",
    "@testing-library/react": "12.1.5",
    "babel-core": "7.0.0-bridge.0",
    "babel-eslint": "10.1.0",
    "babel-jest": "29.7.0",
    "babel-loader": "8.4.1",
    "babel-plugin-istanbul": "^7.0.1",
    "babel-plugin-lodash": "3.3.4",
    "cross-env": "^5.2.1",
    "css-loader": "^1.0.1",
    "eslint": "5.16.0",
    "eslint-config-airbnb": "17.1.1",
    "eslint-loader": "2.2.1",
    "eslint-plugin-import": "2.32.0",
    "eslint-plugin-jest": "22.21.0",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-watch": "4.0.2",
    "flexboxgrid": "^6.3.1",
    "html-webpack-plugin": "^3.2.0",
    "jasmine-core": "^3.99.1",
    "jest": "29.7.0",
    "jest-canvas-mock": "2.5.2",
    "lint-staged": "8.2.1",
    "my-local-ip": "^1.0.0",
    "open": "0.0.5",
    "open-browser-webpack-plugin": "0.0.5",
    "postcss-loader": "^3.0.0",
    "react-color": "^2.19.3",
    "react-dropzone": "7.0.1",
    "react-hot-loader": "^4.13",
    "react-test-renderer": "^16.14.0",
    "react-transform-hmr": "^1.0.4",
    "rimraf": "^2.7.1",
    "style-loader": "^0.23.1",
    "uglifyjs-webpack-plugin": "^2.2.0",
    "webpack": "^4.47.0",
    "webpack-cli": "^3.3.12",
    "webpack-dev-server": "^3.11.3"
  },
  "dependencies": {
    "fabric": "^5.5.2",
    "prop-types": "^15.8.1",
    "react": "^17.0.2",
    "react-dom": "^17.0.2"
  }
}
